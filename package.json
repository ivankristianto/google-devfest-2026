{
  "name": "devfest-modern-web-guidance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "slides:snippets": "node scripts/snippets.mjs",
    "slides:dev": "slidev slides.md --port 3030",
    "slides:build": "slidev build slides.md",
    "slides:export": "slidev export slides.md",
    "sample:serve": "node scripts/serve-sample.mjs",
    "sample:test": "playwright test --config sample/tests/playwright.config.js",
    "slides:pages": "slidev build slides.md --without-notes --base /google-devfest-2026/"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@slidev/cli": "53.0.0",
    "playwright-chromium": "1.64.1",
    "sirv": "3.0.2",
    "sirv-cli": "3.0.1"
  }
}
